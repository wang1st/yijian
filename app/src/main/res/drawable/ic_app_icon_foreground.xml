<?xml version="1.0" encoding="utf-8"?>
<!--
  译键 Yijian app icon.

  Modelled on Duolingo's icon language: one bold silhouette, a saturated flat
  background, a thick friendly outline, and nothing that disappears at 48dp.
  A key is what the app is; "A → 中" is what it does.

  Drawn on the 108x108 adaptive-icon grid with the content kept inside the
  centre 72x72 safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled to 0.84 so the rotated keycap's corners stay inside the 36dp adaptive
         safe circle (measured: 33.1dp); otherwise round masks clip the corners. -->
    <group
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:pivotX="54"
        android:pivotY="54">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-8">

        <!-- Pressed edge: offset slab so the key looks physical -->
        <path
            android:pathData="M33,36 h42 a11,11 0 0 1 11,11 v24 a11,11 0 0 1 -11,11 h-42 a11,11 0 0 1 -11,-11 v-24 a11,11 0 0 1 11,-11 z"
            android:fillColor="#3E8F00" />

        <!-- Keycap face -->
        <path
            android:pathData="M33,31 h42 a11,11 0 0 1 11,11 v24 a11,11 0 0 1 -11,11 h-42 a11,11 0 0 1 -11,-11 v-24 a11,11 0 0 1 11,-11 z"
            android:fillColor="#FFFFFF" />

        <!-- A -->
        <path
            android:pathData="M36,62 L42.6,44 L49.2,62"
            android:strokeColor="#1C2B43"
            android:strokeWidth="5.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M38.9,55.4 h7.4"
            android:strokeColor="#1C2B43"
            android:strokeWidth="5"
            android:strokeLineCap="round" />

        <!-- Arrow: the translation step, kept short and bold -->
        <path
            android:pathData="M53,53 h6.4"
            android:strokeColor="#58CC02"
            android:strokeWidth="5.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M56.6,49.6 l4,3.4 -4,3.4"
            android:strokeColor="#58CC02"
            android:strokeWidth="5.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 中 (zhōng): the standard construction — a rectangular mouth (口) with the
             vertical stroke passing straight through its centre, projecting above and
             below. Drawn on the same baseline as the A so the pair sits level. -->
        <path
            android:pathData="M68.8,48.6 h11.4 v9.2 h-11.4 z"
            android:strokeColor="#1C2B43"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M74.5,44.4 v18"
            android:strokeColor="#1C2B43"
            android:strokeWidth="4.2"
            android:strokeLineCap="round" />
    </group>
    </group>
</vector>
