<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons.

  The system replaces every colour with a single tint, so only the alpha
  channel matters: the shape must be one connected silhouette. The keycap
  outline with the A → 中 punched out of it survives, because the system
  renders the fill and leaves the holes as holes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:pivotX="54"
        android:pivotY="54">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-8">
        <!-- Keycap with the glyph shapes as even-odd holes -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M33,31 h42 a11,11 0 0 1 11,11 v24 a11,11 0 0 1 -11,11 h-42 a11,11 0 0 1 -11,-11 v-24 a11,11 0 0 1 11,-11 z
                          M36.2,61 L42.6,44.2 L49,61 Z
                          M38.7,56.6 h7.8 v-2.4 h-7.8 Z
                          M52.6,54.2 h6.2 v-2.4 h-6.2 Z
                          M56.9,48.2 l5.4,4.6 -5.4,4.6 -1.6,-1.9 3.1,-2.7 -3.1,-2.7 Z
                          M68.6,47.4 h11.8 v11 h-11.8 Z
                          M73.3,42.4 h2.4 v20.4 h-2.4 Z" />
    </group>
    </group>
</vector>
