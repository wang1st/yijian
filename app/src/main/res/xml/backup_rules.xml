<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include
        domain="root"
        path="jetpref_datastore"/>
    <include
        domain="file"
        path="ime"/>
    <include
        domain="database"
        path="floris_user_dictionary"/>
    <!-- yijian: the practice log and review schedule are the user's own learning record and
         cannot be regenerated, so they must survive a device restore. -->
    <include
        domain="file"
        path="yijian_practice.jsonl"/>
    <include
        domain="file"
        path="yijian_srs.json"/>
</full-backup-content>
